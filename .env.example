GOOGLE_API_KEY=your_value_here
MODEL=your_value_here

# Inventory agent model provider: gemini or openai
MODEL_PROVIDER=your_value_here

# OpenAI via LiteLLM
OPENAI_API_KEY=your_value_here
LITELLM_MODEL=openai/gpt-4.1-mini-2025-04-14

# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_phone_number_id
WEBHOOK_VERIFY_TOKEN=your_chosen_verify_token

# MongoDB
MONGO_READ_URI=your_value_here
MONGO_WRITE_URI=your_value_here
MONGO_DB_NAME=your_value_here
MONGO_PRODUCTS_COLLECTION=your_value_here
MONGO_PAYMENTS_COLLECTION=your_value_here
MONGO_SALES_HISTORY_COLLECTION=your_value_here
MONGO_INVENTORY_SNAPSHOTS_COLLECTION=your_value_here
MONGO_INVENTORY_DIFF_COLLECTION=your_value_here
