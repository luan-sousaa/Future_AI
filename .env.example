GOOGLE_API_KEY=your_value_here
MODEL=your_value_here

# Model provider: gemini | google | openai | litellm | ollama | vllm
MODEL_PROVIDER=your_value_here

# OpenAI via LiteLLM
OPENAI_API_KEY=your_value_here
LITELLM_MODEL=openai/gpt-4.1-mini-2025-04-14

# Ollama. With docker compose, OLLAMA_API_BASE is overridden to the bundled
# ollama service. For local dev against host Ollama, leave the default; to reach
# host Ollama from inside a container use http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_API_BASE=http://localhost:11434

# vLLM (reuses OPENAI_API_KEY)
VLLM_MODEL=openai/Qwen/Qwen2.5-7B-Instruct
VLLM_API_BASE=http://localhost:8000/v1

# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_phone_number_id
WEBHOOK_VERIFY_TOKEN=your_chosen_verify_token

# MongoDB
# With docker compose, the READ/WRITE URIs are overridden to the bundled
# `mongo` service automatically — leave them as-is for the self-contained run.
# For an EXTERNAL MongoDB (Atlas), set both to your connection string.
MONGO_READ_URI=mongodb://localhost:27017
MONGO_WRITE_URI=mongodb://localhost:27017
MONGO_DB_NAME=future_ai
MONGO_PRODUCTS_COLLECTION=products
MONGO_PAYMENTS_COLLECTION=payments
MONGO_SALES_HISTORY_COLLECTION=sales_history
MONGO_INVENTORY_SNAPSHOTS_COLLECTION=inventory_snapshots
MONGO_INVENTORY_DIFF_COLLECTION=inventory_diff

# Front-end → ADK API server (Streamlit uses this to reach the agent).
# Local run: http://localhost:8000 | docker compose: http://agent-api:8000
AGENT_API_URL=http://localhost:8000

# Observability (Phoenix / OTEL)
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# Inventory alert emails (SMTP)
SMTP_HOST=your_value_here
SMTP_PORT=587
SMTP_USERNAME=your_value_here
SMTP_PASSWORD=your_value_here
ALERT_EMAIL_FROM=your_value_here
ALERT_EMAIL_TO=your_value_here
